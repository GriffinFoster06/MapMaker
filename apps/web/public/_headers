# Cloudflare Pages response headers (ARCHITECTURE.md Q18). Cross-origin isolation lets the engine use
# SharedArrayBuffer and threaded WASM without the coi-serviceworker shim that GitHub Pages needs.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff

# Vite emits content-hashed file names under assets/, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
