{
  "name": "mapmaker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/carto",
    "packages/core",
    "packages/engine",
    "packages/gen-orogen",
    "packages/planet",
    "packages/projection",
    "tools/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "npm run build -w @mapmaker/web",
    "e2e": "playwright test",
    "provenance:check": "tsx tools/provenance/check.ts",
    "probe": "tsx --import ./packages/projection/alias/register.mjs tools/determinism/node-probe.ts",
    "bench": "playwright test -c playwright.bench.config.ts",
    "desktop:build": "npm run build && npm run build -w @mapmaker/desktop",
    "desktop:dev": "npm run desktop:build && npm start -w @mapmaker/desktop",
    "desktop:smoke": "playwright test -c playwright.desktop.config.ts",
    "desktop:perf": "node scripts/desktop-perf.mjs",
    "desktop:dist": "scripts/build-desktop.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.5.2",
    "esbuild": "0.25.10",
    "eslint": "9.36.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
